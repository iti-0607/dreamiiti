# DreamIITi Environment Configuration Example
# Copy this file to server/.env or configure in your deployment environment

PORT=5000
NODE_ENV=development

# Database Connection:
# For local SQLite development (default zero-dependency):
DATABASE_URL="file:./dev.db"

# For PostgreSQL in Docker or Managed Cloud (Supabase, Neon, AWS RDS):
# DATABASE_URL="postgresql://dreamuser:dreampass@localhost:5432/dreamiiti?schema=public"

# Authentication Secrets:
JWT_SECRET="replace_with_a_secure_random_64_char_secret_for_production"
SESSION_SECRET="replace_with_a_secure_session_secret_for_production"

# Allowed CORS Origins:
CORS_ORIGIN="http://localhost:5173"

# Optional External AI API Key (DreamIITi works 100% out-of-the-box with deterministic planning without these):
GEMINI_API_KEY=""
OPENAI_API_KEY=""
